<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FrostedCardBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderBrush" Value="#40FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#CC1E293B" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="FrostedTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="FrostedSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="FrostedMenuButton" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#F1F5F9" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="#24FFFFFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#3AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#50FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FrostedMenuButtonDanger" TargetType="Button" BasedOn="{StaticResource FrostedMenuButton}">
        <Setter Property="Foreground" Value="#FCA5A5" />
    </Style>
</ResourceDictionary>
