<Window x:Class="WeatherAlert.TrayPopup.Wpf.Views.CitySelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="切换城市"
        Width="440"
        Height="580"
        MinWidth="400"
        MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F5F7FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="当前使用城市"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#1E293B"
                   Margin="0,0,0,8" />

        <Border Grid.Row="1"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding CurrentCityText}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Foreground="#1D4ED8" />
        </Border>

        <Separator Grid.Row="2" Margin="0,0,0,12" />

        <TextBlock Grid.Row="3"
                   Text="当前定位城市"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#1E293B"
                   Margin="0,0,0,8" />

        <Border Grid.Row="4"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding LocatedCityText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="#334155" />
                <Button Grid.Column="1"
                        Content="重新定位"
                        Margin="8,0,8,0"
                        Padding="10,4"
                        IsEnabled="{Binding CanRefreshLocation}"
                        Click="OnRefreshLocationClick" />
                <Button Grid.Column="2"
                        Content="使用定位"
                        Padding="10,4"
                        Click="OnUseLocatedCityClick" />
            </Grid>
        </Border>

        <Separator Grid.Row="5" Margin="0,0,0,12" />

        <TextBlock Grid.Row="6"
                   Text="搜索城市或省份（中文名或 Location ID）"
                   Foreground="#64748B"
                   FontSize="12"
                   Margin="0,0,0,4" />
        <TextBox Grid.Row="7"
                 x:Name="SearchBox"
                 Margin="0,0,0,8"
                 Padding="8,6"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 />

        <ListBox Grid.Row="8"
                 x:Name="CityList"
                 ItemsSource="{Binding CitiesView}"
                 SelectedItem="{Binding SelectedCity, Mode=TwoWay}"
                 BorderBrush="#E2E8F0"
                 Background="#FFFFFF">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#F1F5F9"
                                    Padding="8,4"
                                    Margin="0,8,0,4">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Foreground="#475569" />
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}"
                               Padding="4,2"
                               Foreground="#334155" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="确定"
                    Width="88"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnOkClick" />
            <Button Content="取消"
                    Width="88"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
