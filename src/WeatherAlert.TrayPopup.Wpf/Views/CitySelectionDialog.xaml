<Window x:Class="WeatherAlert.TrayPopup.Wpf.Views.CitySelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="切换城市"
        Width="360"
        Height="160"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ComboBox x:Name="CityCombo"
                  Grid.Row="0"
                  DisplayMemberPath="Display"
                  SelectedValuePath="Code" />
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="确定"
                    Width="75"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnOkClick" />
            <Button Content="取消"
                    Width="75"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
