<Window x:Class="WeatherAlert.TrayPopup.Wpf.Views.FrostedFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WeatherAlert Flyout"
        Width="360"
        Height="420"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        Focusable="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WeatherAlert.TrayPopup.Wpf;component/Themes/FrostedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource FrostedCardBorder}"
            Padding="20"
            MouseEnter="OnCardMouseEnter"
            MouseLeave="OnCardMouseLeave">
        <StackPanel>
            <TextBlock Text="WeatherAlert"
                       Style="{StaticResource FrostedTitleText}"
                       Margin="0,0,0,8" />
            <TextBlock Text="降雨概览"
                       Style="{StaticResource FrostedSubtitleText}" />
            <TextBlock x:Name="TodayText"
                       FontSize="13"
                       Foreground="#E2E8F0"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />
            <TextBlock x:Name="TomorrowText"
                       FontSize="13"
                       Foreground="#E2E8F0"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <TextBlock x:Name="StatusText"
                       Text="鼠标移开此卡片将自动收起"
                       FontSize="12"
                       Foreground="#94A3B8"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
