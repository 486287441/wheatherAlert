<Window
    x:Class="WeatherAlert.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WeatherAlert">
    <Grid Padding="{StaticResource FluentPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleBlock" FontSize="32" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Windows 11 Fluent 界面" Opacity="0.72" />

        <GridView x:Name="HistoryGrid" Grid.Row="2" IsItemClickEnabled="False">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="{StaticResource FluentCornerRadius}" Padding="16" Margin="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6" Width="300">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Body}" TextWrapping="WrapWholeWords"/>
                            <TextBlock Text="{Binding CreatedAt}" Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="CityPanel" Grid.Row="3" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
            <ComboBox x:Name="CityCombo" Width="360" />
            <Button Content="保存城市" Style="{ThemeResource AccentButtonStyle}" Click="OnSaveCityClicked"/>
        </StackPanel>
    </Grid>
</Window>
