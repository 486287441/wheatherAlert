{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeatherAlert",
  "version": "2.0.0",
  "identifier": "com.weatheralert.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WeatherAlert",
        "width": 1180,
        "height": 790,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "安静、漂亮的桌面降雨提醒",
    "longDescription": "WeatherAlert 会在后台检查未来天气，并在降雨来临前提醒你。",
    "resources": [],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
